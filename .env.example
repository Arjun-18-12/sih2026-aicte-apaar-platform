# AICTE-APAAR Platform - Environment Variables
# Copy this file to .env and fill in your actual Supabase values.
# NEVER commit .env to version control.

# Supabase Project URL (from: Supabase Dashboard > Settings > API > Project URL)
VITE_SUPABASE_URL=

# Supabase Publishable (anon) Key (from: Supabase Dashboard > Settings > API > anon public)
# This is safe to use in the frontend because Row Level Security (RLS) is enabled.
VITE_SUPABASE_ANON_KEY=

# Application Settings
VITE_APP_NAME=AICTE-APAAR Platform
VITE_APP_ENV=development

# IMPORTANT SECURITY NOTES:
# 1. Never add SUPABASE_SERVICE_ROLE_KEY to any VITE_ environment variable.
# 2. The service role key must ONLY be used in server-side (Edge Function) code.
# 3. RLS policies are your primary security boundary for the frontend.
